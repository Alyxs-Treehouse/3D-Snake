; Godot 4.4.1 / PICO 4 development starter.
config_version=5

[application]
config/name="Spatial Snake"
config/icon="res://icon.svg"
run/main_scene="res://scenes/snake_game.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.025, 0.04, 0.065, 1)

[xr]
openxr/enabled=true
openxr/default_action_map="res://openxr_action_map.tres"
openxr/extensions/hand_tracking=true
openxr/extensions/spatial_entity/enabled=false
shaders/enabled=true

[audio]
driver/enable_input=true


